@model ClinicaOdontologica.Modelos.Especialidad

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Especialidad</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdEspecialidad" />
            <div class="form-group">
                <label asp-for="nombreEspecialidad" class="control-label"></label>
                <input asp-for="nombreEspecialidad" class="form-control" />
                <span asp-validation-for="nombreEspecialidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="descripcion" class="control-label"></label>
                <input asp-for="descripcion" class="form-control" />
                <span asp-validation-for="descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Odontologos" class="control-label"></label>
                <input asp-for="Odontologos" class="form-control" />
                <span asp-validation-for="Odontologos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model ClinicaOdontologica.Modelos.Cita

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Cita</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="fechaCita" class="control-label"></label>
                <input asp-for="fechaCita" class="form-control" />
                <span asp-validation-for="fechaCita" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="motivo" class="control-label"></label>
                <input asp-for="motivo" class="form-control" />
                <span asp-validation-for="motivo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="estadoCita" class="control-label"></label>
                <input asp-for="estadoCita" class="form-control" />
                <span asp-validation-for="estadoCita" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdPaciente" class="control-label"></label>
                <select asp-for="IdPaciente" class="form-control" asp-items="ViewBag.Pacientes">
                    <option value="">----Seleccion Paciente----</option>
                </select>
                <span asp-validation-for="IdPaciente" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdOdontologo" class="control-label"></label>
                <select asp-for="IdOdontologo" class="form-control" asp-items="ViewBag.Odontologos">
                    <option value="">----Seleccion Odontologo----</option>
                </select>
                <span asp-validation-for="IdOdontologo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdConsultorio" class="control-label"></label>
                <select asp-for="IdConsultorio" class="form-control" asp-items="ViewBag.Consultorios">
                    <option value="">----Seleccion Consultorio----</option>
                </select>
                <span asp-validation-for="IdConsultorio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DetallesCita" class="control-label"></label>
                <input asp-for="DetallesCita" class="form-control" />
                <span asp-validation-for="DetallesCita" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Recetas" class="control-label"></label>
                <input asp-for="Recetas" class="form-control" />
                <span asp-validation-for="Recetas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
